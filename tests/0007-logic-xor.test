-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 5
40 D% = 6
50 E% = 0
60 F% = -1
' XOR truth table, on variables so that nothing is folded
70 A% = E% XOR E%
75 PRINT "0", A%
80 A% = E% XOR F%
85 PRINT "-1", A%
90 A% = F% XOR E%
95 PRINT "-1", A%
100 A% = F% XOR F%
105 PRINT "0", A%
' XOR works bit by bit, it is not a boolean operation
110 A% = 3 XOR 5
115 PRINT "6", A%
120 A% = B% XOR C%
125 PRINT "6", A%
130 A% = 3 XOR C%
135 PRINT "6", A%
140 A% = B% XOR 5
145 PRINT "6", A%
' Priorities: XOR is less priority than AND and OR
150 A% = B% XOR C% AND D%
155 PRINT "7", A%
160 A% = B% XOR C% OR D%
165 PRINT "4", A%
' Logic operations convert Single operands to Integer, see 2.3.6
210 G = 12.0
220 A% = G XOR C%
225 PRINT "9", A%
230 A% = C% XOR G
235 PRINT "9", A%
240 H = 5.0
250 A% = G XOR H
255 PRINT "9", A%
' The fractional part is dropped, the value is not rounded
260 G = 12.7
270 A% = G XOR C%
275 PRINT "9", A%
280 A% = 12.7 XOR C%
285 PRINT "9", A%
' A negative value is truncated towards zero
290 G = -3.5
300 A% = G XOR C%
305 PRINT "-8", A%
310 A% = -3.5 XOR C%
315 PRINT "-8", A%
'NOTE: the cases the compiler reduces, and their warnings, are in 0007-logic-reduced
