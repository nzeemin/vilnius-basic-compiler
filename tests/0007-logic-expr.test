-q
----------------------------------------------------------------------
' Logic expressions test: NOT, and expressions mixing several operations
5 CLS
20 B% = 3
30 C% = 5
' NOT truth table, on variables so that nothing is folded
40 E% = 0
50 F% = -1
60 A% = NOT E%
65 PRINT "-1", A%
70 A% = NOT F%
75 PRINT "0", A%
' NOT works bit by bit, it is not a boolean operation
80 A% = NOT 3
85 PRINT "-4", A%
90 A% = NOT B%
95 PRINT "-4", A%
100 A% = NOT NOT B%
105 PRINT "3", A%
' NOT is more priority than AND, but less than the comparisons
110 A% = NOT B% AND C%
115 PRINT "4", A%
120 A% = NOT B% = C%
125 PRINT "-1", A%
' Expressions mixing several operations
130 A% = &HFF00
140 B% = 1
150 A% = NOT (A% OR B%)
155 PRINT "254", A%
160 A% = &HFFFF
170 B% = A% AND &H00FF
175 PRINT "255", B%
180 B% = &H00FF AND A%
185 PRINT "255", B%
190 A% = 9
200 B% = 17
210 B% = A% AND B%
215 PRINT "1", B%
220 A% = 6%
230 A% = A% OR B%
235 PRINT "7", A%
