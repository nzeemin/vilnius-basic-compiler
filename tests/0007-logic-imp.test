-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 5
40 D% = 6
50 E% = 0
60 F% = -1
' IMP truth table, on variables so that nothing is folded
70 A% = E% IMP E%
75 PRINT "-1", A%
80 A% = E% IMP F%
85 PRINT "-1", A%
90 A% = F% IMP E%
95 PRINT "0", A%
100 A% = F% IMP F%
105 PRINT "-1", A%
' IMP works bit by bit, it is not a boolean operation
110 A% = 3 IMP 5
115 PRINT "-3", A%
120 A% = B% IMP C%
125 PRINT "-3", A%
130 A% = 3 IMP C%
135 PRINT "-3", A%
140 A% = B% IMP 5
145 PRINT "-3", A%
' EQV works bit by bit too; constant and non-constant results must agree
150 A% = 3 EQV 5
155 PRINT "-7", A%
160 A% = B% EQV C%
165 PRINT "-7", A%
' Priorities: NOT, then AND, then OR, then XOR and EQV, then IMP
170 A% = B% OR C% AND D%
175 PRINT "7", A%
180 A% = B% XOR C% AND D%
185 PRINT "7", A%
190 A% = B% XOR C% OR D%
195 PRINT "4", A%
200 A% = B% EQV C% AND D%
205 PRINT "-8", A%
210 A% = B% IMP C% AND D%
215 PRINT "-4", A%
220 A% = B% IMP C% XOR D%
225 PRINT "-1", A%
' Logic operations convert Single operands to Integer, see 2.3.6
270 G = 12.0
280 A% = G IMP C%
285 PRINT "-9", A%
290 A% = C% IMP G
295 PRINT "-2", A%
300 H = 5.0
310 A% = G IMP H
315 PRINT "-9", A%
' The fractional part is dropped, the value is not rounded
320 G = 12.7
330 A% = G IMP C%
335 PRINT "-9", A%
340 A% = 12.7 IMP C%
345 PRINT "-9", A%
' A negative value is truncated towards zero
350 G = -3.5
360 A% = G IMP C%
365 PRINT "7", A%
370 A% = -3.5 IMP C%
375 PRINT "7", A%
'NOTE: the cases the compiler reduces, and their warnings, are in 0007-logic-reduced
