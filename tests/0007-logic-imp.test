-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 5
40 D% = 6
50 E% = 0
60 F% = -1
' IMP truth table, on variables so that nothing is folded
70 A% = E% IMP E%
75 PRINT "-1", A%
80 A% = E% IMP F%
85 PRINT "-1", A%
90 A% = F% IMP E%
95 PRINT "0", A%
100 A% = F% IMP F%
105 PRINT "-1", A%
' IMP works bit by bit, it is not a boolean operation
110 A% = 3 IMP 5
115 PRINT "-3", A%
120 A% = B% IMP C%
125 PRINT "-3", A%
130 A% = 3 IMP C%
135 PRINT "-3", A%
140 A% = B% IMP 5
145 PRINT "-3", A%
' EQV works bit by bit too; constant and non-constant results must agree
150 A% = 3 EQV 5
155 PRINT "-7", A%
160 A% = B% EQV C%
165 PRINT "-7", A%
' Priorities: NOT, then AND, then OR, then XOR and EQV, then IMP
170 A% = B% OR C% AND D%
175 PRINT "7", A%
180 A% = B% XOR C% AND D%
185 PRINT "7", A%
190 A% = B% XOR C% OR D%
195 PRINT "4", A%
200 A% = B% EQV C% AND D%
205 PRINT "-8", A%
210 A% = B% IMP C% AND D%
215 PRINT "-4", A%
220 A% = B% IMP C% XOR D%
225 PRINT "-1", A%
' Special cases with a constant operand: reduced by the compiler with a warning
230 A% = 0 IMP B%
235 PRINT "-1", A%
240 A% = B% IMP -1
245 PRINT "-1", A%
250 A% = -1 IMP B%
255 PRINT "3", A%
260 A% = B% IMP 0
265 PRINT "-4", A%
----------------------------------------------------------------------
WARNING: at 44:12 line 230 - IMP operation with 0 at left reduced to -1; consider to remove the useless IMP
WARNING: at 46:13 line 240 - IMP operation with -1 at right reduced to -1; consider to remove the useless IMP
WARNING: at 48:13 line 250 - IMP operation with -1 at left reduced to no operation; consider to remove the useless IMP
WARNING: at 50:13 line 260 - IMP operation with 0 at right reduced to inversion; consider to replace IMP with NOT
