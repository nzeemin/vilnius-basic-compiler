-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 5
40 D% = 6
50 E% = 0
60 F% = -1
' OR truth table, on variables so that nothing is folded
70 A% = E% OR E%
75 PRINT "0", A%
80 A% = E% OR F%
85 PRINT "-1", A%
90 A% = F% OR E%
95 PRINT "-1", A%
100 A% = F% OR F%
105 PRINT "-1", A%
' OR works bit by bit, it is not a boolean operation
110 A% = 3 OR 5
115 PRINT "7", A%
120 A% = B% OR C%
125 PRINT "7", A%
130 A% = 3 OR C%
135 PRINT "7", A%
140 A% = B% OR 5
145 PRINT "7", A%
' Priorities: OR is less priority than AND, but more priority than XOR
150 A% = B% OR C% AND D%
155 PRINT "7", A%
160 A% = B% OR C% XOR D%
165 PRINT "1", A%
' Logic operations convert Single operands to Integer, see 2.3.6
210 G = 12.0
220 A% = G OR C%
225 PRINT "13", A%
230 A% = C% OR G
235 PRINT "13", A%
240 H = 5.0
250 A% = G OR H
255 PRINT "13", A%
' The fractional part is dropped, the value is not rounded
260 G = 12.7
270 A% = G OR C%
275 PRINT "13", A%
280 A% = 12.7 OR C%
285 PRINT "13", A%
' A negative value is truncated towards zero
290 G = -3.5
300 A% = G OR C%
305 PRINT "-3", A%
310 A% = -3.5 OR C%
315 PRINT "-3", A%
'NOTE: the cases the compiler reduces, and their warnings, are in 0078-logic-reduced
