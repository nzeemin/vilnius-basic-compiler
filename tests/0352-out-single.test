-q
----------------------------------------------------------------------
' OUT with Single arguments. The mask, address and code must each be an
' Integer in R0/R1/R2, so a Single is converted (FTOI), stack balanced.
' Const folds, so these use variables and expressions. Args are nonzero to
' avoid the mask-is-0 warning.
10 F = 5.0
20 G = 10.0
30 H = 1.0
' all three Single, non-const code
40 OUT F, G, H
' Single expressions
50 OUT F + G, G + H, H + F
' Single mask and address, const code 1 (BIS)
60 OUT F, G, 1%
' Single mask and address, const code 0 (BIC)
70 OUT F, G, 0%
----------------------------------------------------------------------
----------------------------------------------------------------------
START:
; Инициализация программы
	MTPS	#340			; disable interrupts
	CLR	@#177560
	MTPS	#0			; enable interrupts
	MOV	SP, SAVESP
; 10 F = 5.0
N10:
	CLR	VARFF		; var F! = const 5.
	MOV	#040640, VARFF+2
; 20 G = 10.0
N20:
	CLR	VARFG		; var G! = const 10.
	MOV	#041040, VARFG+2
; 30 H = 1.0
N30:
	CLR	VARFH		; var H! = const 1.
	MOV	#040200, VARFH+2
; 40 OUT F, G, H
N40:
	MOV	VARFF,   -(SP)	; var F!
	MOV	VARFF+2, -(SP)
	CALL	FTOI		; to Integer
	MOV	R0, -(SP)	; PUSH mask
	MOV	VARFG,   -(SP)	; var G!
	MOV	VARFG+2, -(SP)
	CALL	FTOI		; to Integer
	MOV	R0, R2
	TST	VARFH
	BEQ	.+4
	BIS	(SP)+, (R2)	; OUT BIS
	BR	.+2
	BIC	(SP)+, (R2)	; OUT BIC
; 50 OUT F + G, G + H, H + F
N50:
	MOV	VARFF,   -(SP)	; var F!
	MOV	VARFF+2, -(SP)
	MOV	VARFG,   -(SP)	; var G!
	MOV	VARFG+2, -(SP)
	FADD	SP		; Operation '+'
	CALL	FTOI		; to Integer
	MOV	R0, -(SP)	; PUSH mask
	MOV	VARFG,   -(SP)	; var G!
	MOV	VARFG+2, -(SP)
	MOV	VARFH,   -(SP)	; var H!
	MOV	VARFH+2, -(SP)
	FADD	SP		; Operation '+'
	CALL	FTOI		; to Integer
	MOV	R0, -(SP)	; PUSH address
	MOV	VARFH,   -(SP)	; var H!
	MOV	VARFH+2, -(SP)
	MOV	VARFF,   -(SP)	; var F!
	MOV	VARFF+2, -(SP)
	FADD	SP		; Operation '+'
	CALL	FTOI		; to Integer
	MOV	(SP)+, R2	; POP R2 address
	TST	R0
	BEQ	.+4
	BIS	(SP)+, (R2)	; OUT BIS
	BR	.+2
	BIC	(SP)+, (R2)	; OUT BIC
; 60 OUT F, G, 1%
N60:
	MOV	VARFF,   -(SP)	; var F!
	MOV	VARFF+2, -(SP)
	CALL	FTOI		; to Integer
	MOV	R0, -(SP)	; PUSH mask
	MOV	VARFF,   -(SP)	; var F!
	MOV	VARFF+2, -(SP)
	CALL	FTOI		; to Integer
	MOV	(SP)+, R1	; POP R1 mask
	BIS	R1, (R0)	; OUT
; 70 OUT F, G, 0%
N70:
	MOV	VARFF,   -(SP)	; var F!
	MOV	VARFF+2, -(SP)
	CALL	FTOI		; to Integer
	MOV	R0, -(SP)	; PUSH mask
	MOV	VARFF,   -(SP)	; var F!
	MOV	VARFF+2, -(SP)
	CALL	FTOI		; to Integer
	MOV	(SP)+, R1	; POP R1 mask
	BIC	R1, (R0)	; OUT
LEND:
; Завершение программы
SAVESP = . + 2
	MOV	#776, SP	; restore SP
	EMT	350		; .EXIT
; STRINGS
	.EVEN
ST0:	.WORD	0	; empty string
; VARIABLES
	.EVEN
VARFF:	.WORD	0,0	; F!
VARFG:	.WORD	0,0	; G!
VARFH:	.WORD	0,0	; H!
; RUNTIME CALLS
	.GLOBL	FTOI
	.END	START
