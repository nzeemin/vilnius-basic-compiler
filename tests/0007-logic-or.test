-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 5
40 D% = 6
50 E% = 0
60 F% = -1
' OR truth table, on variables so that nothing is folded
70 A% = E% OR E%
75 PRINT "0", A%
80 A% = E% OR F%
85 PRINT "-1", A%
90 A% = F% OR E%
95 PRINT "-1", A%
100 A% = F% OR F%
105 PRINT "-1", A%
' OR works bit by bit, it is not a boolean operation
110 A% = 3 OR 5
115 PRINT "7", A%
120 A% = B% OR C%
125 PRINT "7", A%
130 A% = 3 OR C%
135 PRINT "7", A%
140 A% = B% OR 5
145 PRINT "7", A%
' Priorities: OR is less priority than AND, but more priority than XOR
150 A% = B% OR C% AND D%
155 PRINT "7", A%
160 A% = B% OR C% XOR D%
165 PRINT "1", A%
' Special cases with a constant operand: reduced by the compiler with a warning
170 A% = -1 OR B%
175 PRINT "-1", A%
180 A% = B% OR -1
185 PRINT "-1", A%
190 A% = 0 OR B%
195 PRINT "3", A%
200 A% = B% OR 0
205 PRINT "3", A%
----------------------------------------------------------------------
WARNING: at 31:13 line 170 - OR operation with -1 reduced to -1; consider to remove the useless OR
WARNING: at 33:13 line 180 - OR operation with -1 reduced to -1; consider to remove the useless OR
WARNING: at 35:12 line 190 - OR operation with 0 reduced to no operation; consider to remove the useless OR
WARNING: at 37:13 line 200 - OR operation with 0 reduced to no operation; consider to remove the useless OR
