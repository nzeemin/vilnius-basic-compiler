-q
----------------------------------------------------------------------
10 CLS
' ON GOTO: the value 1..N gives a jump to the N-th line number of the list;
' zero, a value past the end of the list and a negative value all fall through
' to the next statement. The negative value is a deviation from the original
' Vilnius BASIC, where it gives error 5.
20 I% = 0
30 GOSUB 500
40 PRINT "0", R%
50 I% = 1
60 GOSUB 500
70 PRINT "1", R%
80 I% = 2
90 GOSUB 500
100 PRINT "2", R%
110 I% = 3
120 GOSUB 500
130 PRINT "3", R%
140 I% = 4
150 GOSUB 500
160 PRINT "0", R%
170 I% = -1
180 GOSUB 500
190 PRINT "0", R%
' The value under ON is an expression, not just a variable
200 A% = 1
210 B% = 1
220 I% = A% + B%
230 GOSUB 500
240 PRINT "2", R%
' ON GOSUB: RETURN has to come back to the statement right after the ON
250 I% = 0
260 GOSUB 600
270 PRINT "100", R%
280 I% = 1
290 GOSUB 600
300 PRINT "101", R%
310 I% = 2
320 GOSUB 600
330 PRINT "102", R%
340 I% = 3
350 GOSUB 600
360 PRINT "103", R%
370 I% = 5
380 GOSUB 600
390 PRINT "100", R%
400 END
' ON GOTO subroutine: R% gets the number of the branch taken, or 0 if none
500 ON I% GOTO 520,540,560
510 R% = 0
515 RETURN
520 R% = 1
530 RETURN
540 R% = 2
550 RETURN
560 R% = 3
570 RETURN
' ON GOSUB subroutine: 100 is added after the ON, so RETURN has to land there
600 R% = 0
610 ON I% GOSUB 700,720,740
620 R% = R% + 100
630 RETURN
700 R% = 1
710 RETURN
720 R% = 2
730 RETURN
740 R% = 3
750 RETURN
