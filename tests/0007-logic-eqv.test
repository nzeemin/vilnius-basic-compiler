-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 5
40 D% = 6
50 E% = 0
60 F% = -1
' EQV truth table, on variables so that nothing is folded
70 A% = E% EQV E%
75 PRINT "-1", A%
80 A% = E% EQV F%
85 PRINT "0", A%
90 A% = F% EQV E%
95 PRINT "0", A%
100 A% = F% EQV F%
105 PRINT "-1", A%
' EQV works bit by bit, it is not a boolean operation
110 A% = 3 EQV 5
115 PRINT "-7", A%
120 A% = B% EQV C%
125 PRINT "-7", A%
130 A% = 3 EQV C%
135 PRINT "-7", A%
140 A% = B% EQV 5
145 PRINT "-7", A%
' Priorities: EQV is less priority than AND and OR
150 A% = B% EQV C% AND D%
155 PRINT "-8", A%
160 A% = B% EQV C% OR D%
165 PRINT "-5", A%
' Logic operations convert Single operands to Integer, see 2.3.6
210 G = 12.0
220 A% = G EQV C%
225 PRINT "-10", A%
230 A% = C% EQV G
235 PRINT "-10", A%
240 H = 5.0
250 A% = G EQV H
255 PRINT "-10", A%
' The fractional part is dropped, the value is not rounded
260 G = 12.7
270 A% = G EQV C%
275 PRINT "-10", A%
280 A% = 12.7 EQV C%
285 PRINT "-10", A%
' A negative value is truncated towards zero
290 G = -3.5
300 A% = G EQV C%
305 PRINT "7", A%
310 A% = -3.5 EQV C%
315 PRINT "7", A%
'NOTE: the cases the compiler reduces, and their warnings, are in 0007-logic-reduced
