-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 5
40 D% = 6
50 E% = 0
60 F% = -1
' AND truth table, on variables so that nothing is folded
70 A% = E% AND E%
75 PRINT "0", A%
80 A% = E% AND F%
85 PRINT "0", A%
90 A% = F% AND E%
95 PRINT "0", A%
100 A% = F% AND F%
105 PRINT "-1", A%
' AND works bit by bit, it is not a boolean operation
110 A% = 3 AND 5
115 PRINT "1", A%
120 A% = B% AND C%
125 PRINT "1", A%
130 A% = 3 AND C%
135 PRINT "1", A%
140 A% = B% AND 5
145 PRINT "1", A%
' Priorities: AND is more priority than OR, but less than the comparisons
150 A% = B% AND C% OR D%
155 PRINT "7", A%
160 A% = B% = 3 AND C% = 5
165 PRINT "-1", A%
' Logic operations convert Single operands to Integer, see 2.3.6
210 G = 12.0
220 A% = G AND C%
225 PRINT "4", A%
230 A% = C% AND G
235 PRINT "4", A%
240 H = 5.0
250 A% = G AND H
255 PRINT "4", A%
' The fractional part is dropped, the value is not rounded
260 G = 12.7
270 A% = G AND C%
275 PRINT "4", A%
280 A% = 12.7 AND C%
285 PRINT "4", A%
' A negative value is truncated towards zero
290 G = -3.5
300 A% = G AND C%
305 PRINT "5", A%
310 A% = -3.5 AND C%
315 PRINT "5", A%
'NOTE: the cases the compiler reduces, and their warnings, are in 0007-logic-reduced
