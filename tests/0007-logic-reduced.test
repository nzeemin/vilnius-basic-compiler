-q
----------------------------------------------------------------------
' Every case the compiler reduces to something simpler, with its warning.
' B% is Integer, G is Single: the reduced cases still convert Single to Integer.
10 CLS
20 B% = 3
30 G = 12.7
' AND: 0 gives 0, -1 gives the other operand
100 A% = 0 AND B%
105 PRINT "0", A%
110 A% = B% AND 0
115 PRINT "0", A%
120 A% = -1 AND B%
125 PRINT "3", A%
130 A% = B% AND -1
135 PRINT "3", A%
140 A% = -1 AND G
145 PRINT "12", A%
150 A% = G AND -1
155 PRINT "12", A%
' OR: -1 gives -1, 0 gives the other operand
160 A% = -1 OR B%
165 PRINT "-1", A%
170 A% = B% OR -1
175 PRINT "-1", A%
180 A% = 0 OR B%
185 PRINT "3", A%
190 A% = B% OR 0
195 PRINT "3", A%
200 A% = 0 OR G
205 PRINT "12", A%
210 A% = G OR 0
215 PRINT "12", A%
' XOR: 0 gives the other operand, -1 inverts it
220 A% = 0 XOR B%
225 PRINT "3", A%
230 A% = B% XOR 0
235 PRINT "3", A%
240 A% = -1 XOR B%
245 PRINT "-4", A%
250 A% = B% XOR -1
255 PRINT "-4", A%
260 A% = 0 XOR G
265 PRINT "12", A%
270 A% = G XOR 0
275 PRINT "12", A%
280 A% = -1 XOR G
285 PRINT "-13", A%
290 A% = G XOR -1
295 PRINT "-13", A%
' EQV: -1 gives the other operand, 0 inverts it
300 A% = -1 EQV B%
305 PRINT "3", A%
310 A% = B% EQV -1
315 PRINT "3", A%
320 A% = 0 EQV B%
325 PRINT "-4", A%
330 A% = B% EQV 0
335 PRINT "-4", A%
340 A% = -1 EQV G
345 PRINT "12", A%
350 A% = G EQV -1
355 PRINT "12", A%
360 A% = 0 EQV G
365 PRINT "-13", A%
370 A% = G EQV 0
375 PRINT "-13", A%
' IMP: the four cases differ by the side the constant is at
380 A% = 0 IMP B%
385 PRINT "-1", A%
390 A% = B% IMP -1
395 PRINT "-1", A%
400 A% = -1 IMP B%
405 PRINT "3", A%
410 A% = B% IMP 0
415 PRINT "-4", A%
420 A% = -1 IMP G
425 PRINT "12", A%
430 A% = G IMP 0
435 PRINT "-13", A%
----------------------------------------------------------------------
