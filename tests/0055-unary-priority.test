-q
----------------------------------------------------------------------
10 CLS
20 B% = 3
30 C% = 1
' Unary minus binds tighter than '*', '\' and MOD
40 A% = -B% * 2%
45 PRINT "-6", A%
50 A% = -B% + 2%
55 PRINT "-1", A%
60 A% = 2% - -B% * 2%
65 PRINT "8", A%
70 A% = -B% \ 2%
75 PRINT "-1", A%
' Unary NOT binds looser than the comparisons, tighter than AND/OR
80 A% = NOT B% = C%
85 PRINT "-1", A%
90 A% = NOT B% > C%
95 PRINT "0", A%
100 A% = NOT C% > B% AND B%
105 PRINT "3", A%
110 A% = NOT C% = C% OR B%
115 PRINT "3", A%
'NOTE: The unary-minus versus '^' precedence is not covered here:
'      the FPWI runtime block does not exist yet, so a non-constant
'      '^' would generate a TODO and fail the test.
